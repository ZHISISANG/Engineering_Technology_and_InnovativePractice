# 统一换行：仓库内一律 LF，避免 Windows 检出后脚本出现 CRLF
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
